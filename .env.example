# KubeSay configuration — copy to .env and fill in your own values.
# Never commit real secrets; this file documents placeholders only.

# Groq free-tier API key (required only when KUBESAY_BACKEND=groq)
GROQ_API_KEY=your-groq-free-tier-key-here

# Active LLM backend: "ollama" (local/offline default) or "groq" (cloud-free)
KUBESAY_BACKEND=ollama

# Ollama (local) backend
KUBESAY_OLLAMA_ENDPOINT=http://localhost:11434/v1
KUBESAY_OLLAMA_MODEL=qwen2.5

# Groq (cloud-free) backend
KUBESAY_GROQ_ENDPOINT=https://api.groq.com/openai/v1
KUBESAY_GROQ_MODEL=llama-3.1-8b-instant

# Reasoner retry limit for structured-output parsing
KUBESAY_RETRY_LIMIT=3

# Output format: "table" (default) or "json"
KUBESAY_OUTPUT=table
